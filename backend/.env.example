# Copia este archivo como .env.local y ajusta los valores.

# Secreto para firmar los JWT (usa una cadena larga y aleatoria).
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Duración del token de sesión.
JWT_EXPIRES_IN=7d

# URL pública del backend. Se usa para construir el enlace de recuperación
# de contraseña. Si abres el correo desde el celular, usa la IP de tu PC en la red
# local, por ejemplo http://192.168.1.50:3000
APP_URL=http://localhost:3000

# SMTP para enviar el correo de recuperación (Gmail, Mailtrap, etc.).
# Si no se configura, se usa una cuenta de prueba de Ethereal y el enlace
# se imprime en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tienda App <no-reply@tienda.app>"
