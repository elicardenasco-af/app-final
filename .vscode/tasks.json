{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: iniciar",
      "type": "shell",
      "command": "./scripts/start_backend.sh",
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "backend",
        "pattern": { "regexp": "^__nunca__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Backend|Encendiendo|Instalando",
          "endsPattern": "Ready"
        }
      }
    }
  ]
}
